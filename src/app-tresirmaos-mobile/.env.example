# Configurações da API Azure Functions (Backend de Produção)
EXPO_PUBLIC_AZURE_API_URL=https://your-api.azurewebsites.net

# Webhook do middleware n8n (Inteligência Operacional)
EXPO_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-webhook.domain/webhook/ia-analysis

# API IoT / Telemetria da Câmara Fria (Flask / LocalTunnel)
EXPO_PUBLIC_IOT_API_URL=https://your-iot-api.domain

# Microsoft Entra ID (Autenticação Corporativa)
EXPO_PUBLIC_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_REDIRECT_URI=exp://localhost:8081
